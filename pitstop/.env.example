# Local UI-only preview (skip login; mock schedule-change). Auto-on when VITE_SUPABASE_* unset.
# VITE_DEV_PREVIEW=true

# ── Frontend (Vite — exposed to browser with VITE_ prefix) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Netlify Functions (server only — never commit real values) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

AUTH_ALLOWED_EMAIL_DOMAIN=varsitytutors.com

# ── Sheet logic (source of truth for approve/deny) ──
# Deploy Meeting Governor script with doPost → copy /exec URL here
PITSTOP_MEETING_LOGIC_URL=https://script.google.com/macros/s/XXXX/exec
# Deploy Permanent Schedule Publisher + pitstop-permanent-bridge.gs in same project
PITSTOP_PERMANENT_LOGIC_URL=https://script.google.com/macros/s/YYYY/exec
# Optional fallback if you use one combined bridge
# PITSTOP_SHEET_LOGIC_URL=

# Shared secret (also set Script Property PITSTOP_BRIDGE_SECRET in Apps Script)
PITSTOP_BRIDGE_SECRET=generate-a-long-random-string

# Slack user ID for WFM review pings (optional)
PITSTOP_WFM_SLACK_USER_ID=

ASSEMBLED_API_KEY=
ASSEMBLED_BASE_URL=https://api.assembledhq.com
SLACK_BOT_TOKEN=
